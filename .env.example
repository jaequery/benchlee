# Postgres connection used by the Next.js app and the migrate/seed scripts.
# docker compose sets this for you; this value is for running `pnpm dev` on the host
# against the compose database (`docker compose up db`).
DATABASE_URL=postgres://benchlee:benchlee@localhost:5432/benchlee

# Public origin, used for share links, canonical URLs and OG image absolute paths.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 0 to skip the automatic seed on container start.
BENCHLEE_AUTO_SEED=1

# --- Optional: live benchmark runs (scripts/run-benchmark.mjs) ---
# With no keys set the runner refuses to invent results and exits.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Enables paid /benchmark calls. Share only with authorized operators.
BENCHMARK_ACCESS_TOKEN=
